{"schema_version":"v1","default_profile_id":"text-hybrid","profiles":[{"profile_id":"text-hybrid","stages":[{"stage_id":"keyword","kind":"retrieve","plugin_id":"retriever.keyword@1","configuration":{"limit":8},"inputs":{"question":"query.question","index":"search.index"},"outputs":["candidates"]},{"stage_id":"vector","kind":"retrieve","plugin_id":"retriever.vector@1","configuration":{"limit":8},"inputs":{"question":"query.question","index":"search.index"},"outputs":["candidates"]},{"stage_id":"fuse","kind":"fuse","plugin_id":"fusion.reciprocal-rank@1","configuration":{"limit":8},"inputs":{"candidate_sets":["keyword.candidates","vector.candidates"]},"outputs":["fused_candidates"]},{"stage_id":"context","kind":"context","plugin_id":"context.from-fusion@1","configuration":{"max_items":8,"max_tokens":2048,"max_excerpt_chars":1024},"inputs":{"candidates":"fuse.fused_candidates","index":"search.index"},"outputs":["evidence"]},{"stage_id":"generate","kind":"generate","plugin_id":"generator.deepseek@1","configuration":{"model":"deepseek-v4-flash"},"inputs":{"question":"query.question","evidence":"context.evidence"},"outputs":["answer"]},{"stage_id":"verify","kind":"verify","plugin_id":"verifier.grounded@1","configuration":{"minimum_items":1},"inputs":{"answer":"generate.answer","evidence":"context.evidence"},"outputs":["verification"]},{"stage_id":"repair","kind":"repair","plugin_id":"query.repair-control@1","configuration":{},"max_attempts":2,"inputs":{"evidence":"context.evidence","answer":"generate.answer","verification":"verify.verification"},"outputs":["answer","verification"]},{"stage_id":"final","kind":"final_state","plugin_id":"query.final-state@1","configuration":{},"inputs":{"evidence":"context.evidence","verification":"repair.verification","answer":"repair.answer"},"outputs":["response"]}]}]}
